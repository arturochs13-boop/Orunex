# Copy to .env and fill in. NEVER commit a real key.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Primary reasoning/chat/trading model (Meta Muse only).
# Muse Wonder is the stronger long-horizon model; Muse Spark is the fast model.
META_MODEL=muse-wonder-1.0
META_API_TIMEOUT=120
# Muse counts hidden reasoning tokens against max_tokens. The demo uses an
# 8192-token ceiling with a slightly higher sampling temperature.
META_MAX_TOKENS=8192
META_TEMPERATURE=0.3
META_REASONING_EFFORT=high

# Fast model for routing, extraction and screen vision.
META_FAST_MODEL=muse-spark-1.3
META_FAST_MAX_TOKENS=2048
META_FAST_REASONING_EFFORT=low

# Screen vision stays fast; META_AI_VISION_MODEL takes precedence over
# META_MODEL inside the live-vision provider.
META_AI_VISION_MODEL=muse-spark-1.3
META_VISION_REASONING_EFFORT=minimal

# Workspace whose source code FAISS indexes and the agent may patch.
# Empty = the repository root and its android/ folder (recommended).
AGENT_WORKSPACE=
ANDROID_PROJECT_DIR=
ANDROID_PACKAGE=com.orunex.mobile
ANDROID_ACTIVITY=
# Optional: absolute path to adb.exe and a specific device serial.
ADB_PATH=
ADB_SERIAL=
# If set, the ADB bridge auto-starts this emulator AVD when no device is ready.
ANDROID_AVD=

# Empty = <repo>/data/hackathon_memory.index
FAISS_INDEX_PATH=

# Guarded autonomy: when true, exact patches are applied (with backup + diff).
AGENT_AUTO_APPLY_FIXES=false
AGENT_MAX_PATCH_REPLACEMENTS=3

# Simplex Chat CLI WebSocket (encrypted remote channel).
SIMPLEX_ENABLED=false
SIMPLEX_WS_URL=ws://127.0.0.1:5227
SIMPLEX_CONTACT=
REMOTE_DUPLICATE_WINDOW_S=90

# Low-latency preparation: pre-open the emulator and TradingView in background.
AGENT_WARMUP_ON_START=false

# ── Autonomy & Safety Knobs ──────────────────────────────────────────────
# ORUNEX_STRICT_PERM (default "1"): 0 = allow dangerous actions without UI confirmation.
#   Use ORUNEX_STRICT_PERM=0 for trusted headless runs; keep "1" for confirmation-gated mode.
ORUNEX_STRICT_PERM=0

# ORUNEX_AGENT_MAX_TOOL_CALLS (default "6"): max tool calls allowed in the agent loop.
ORUNEX_AGENT_MAX_TOOL_CALLS=10

# ORUNEX_AGENT_MAX_STEPS (default "8"): max steps (including reasoning) in the agent loop.
ORUNEX_AGENT_MAX_STEPS=12

# ORUNEX_AGENT_TIME_BUDGET (default "120"): wall-clock budget in seconds for the agent loop.
ORUNEX_AGENT_TIME_BUDGET=180

# ORUNEX_ALLOW_DANGEROUS (default "0"): 1 = allow dangerous actions when no UI confirm callback.
ORUNEX_ALLOW_DANGEROUS=1

# ORUNEX_AGGRESSIVE (default "0"): 1 = relax mode‑router and permission guards for faster operation.
ORUNEX_AGGRESSIVE=1

# ORUNEX_VERBOSE (default "0"): 1 = print environment summary at startup.
ORUNEX_VERBOSE=0

# TradingView Desktop opens the chart symbol for Muse/paper execution.
# The executable/app id are auto-detected on Windows when left empty.
TRADINGVIEW_ENABLED=true
TRADINGVIEW_APP_ID=
TRADINGVIEW_EXE=
TRADINGVIEW_CHART_BASE_URL=https://www.tradingview.com/chart/
TRADINGVIEW_LAUNCH_TIMEOUT_S=25
TRADINGVIEW_CAPTURE_CHART=true
# Optional rehearsal hook: use a controlled chart under demo/charts instead
# of a live capture. Leave empty for normal screen vision.
# ORUNEX_DEMO_CHART=

# ── Virtual input layer ──────────────────────────────────────────────────
# Orunex drives the desktop with its own pointer and Unicode keyboard instead
# of whichever window happens to have focus. ORUNEX_VIRTUAL_INPUT=0 disables
# the layer and falls back to PyAutoGUI; ORUNEX_VIRTUAL_CURSOR=0 keeps the
# input channel but hides the visible agent pointer.
ORUNEX_VIRTUAL_INPUT=1
ORUNEX_VIRTUAL_CURSOR=1
# ORUNEX_GHOST_CLICK (default "1"): hide the system cursor only for the few
# milliseconds of each click/scroll, then restore it untouched. Set to 0 on
# machines where hiding the cursor is blocked.
ORUNEX_GHOST_CLICK=1
# Multiplier for pointer travel and typing cadence (1.0 = normal, 2.0 = slower).
ORUNEX_INPUT_SPEED=1.0
# ORUNEX_INPUT_HUMAN (default "1"): human-like typing jitter and pauses.
ORUNEX_INPUT_HUMAN=1

# PAPER TRADING ONLY — there is no real-broker code path.
PAPER_INITIAL_BALANCE=10000
PAPER_CURRENCY=USD
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0
MIN_TRADE_CONFIDENCE=0.70
# Explicit user orders ("ejecuta", "abre una orden paper") may use this
# lower bar, still requiring Muse BUY/SELL + coherent SL/TP. Paper only.
EXPLICIT_TRADE_MIN_CONFIDENCE=0.60
PAPER_DUPLICATE_WINDOW_S=900
# Empty = <repo>/data/paper_trading.json
PAPER_STATE_PATH=
